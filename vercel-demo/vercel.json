{
  "routes": [
    {
      "src": "/(?:index.html)?",
      "dest": "/index.html"
    },
    {
      "src": "/edge/(.*)",
      "dest": "/edge/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://campusloop-g9zj.onrender.com/api/$1"
    },
    {
      "src": "/_healthz",
      "dest": "https://campusloop-g9zj.onrender.com/_healthz"
    },
    {
      "src": "/product/[^/]+/?",
      "dest": "/edge/product.html"
    },
    {
      "src": "/(login|signin|signup)/?",
      "dest": "/edge/signin.html"
    },
    {
      "src": "/(post-item|my-listings|messages)/?",
      "dest": "/edge/$1.html"
    },
    {
      "src": "/cart",
      "status": 302,
      "headers": {
        "Location": "/my-listings"
      }
    },
    {
      "src": "/marketplace",
      "status": 302,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/.*",
      "dest": "/edge/not-found.html",
      "status": 404
    }
  ]
}
